[Unit]
Description=Attach and verify the existing Cinder loopback volume group
After=local-fs.target systemd-remount-fs.service
RequiresMountsFor=/var/lib/cinder/cinder-volumes.img
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/xregion-network/attach-cinder-loop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
