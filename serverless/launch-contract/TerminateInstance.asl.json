{
  "Comment": "xregion linux-nat-v1 contract 1",
  "StartAt": "LoadNetworkContext",
  "TimeoutSeconds": 1800,
  "States": {
    "LoadNetworkContext": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-Network-Release",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChooseNetworkMode",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "ChooseNetworkMode": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.network_mode",
              "StringEquals": "linux_nat_v1"
            },
            {
              "Variable": "$.network_cleanup_complete",
              "BooleanEquals": true
            }
          ],
          "Next": "DeleteSecurityGroup"
        },
        {
          "Variable": "$.network_mode",
          "StringEquals": "linux_nat_v1",
          "Next": "RemoveNatMapping"
        }
      ],
      "Default": "LegacyDeleteSecurityGroup"
    },
    "RemoveNatMapping": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-Network-Dispatch",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitNatCommand",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "WaitNatCommand": {
      "Type": "Wait",
      "Seconds": 3,
      "Next": "CheckNatCommand"
    },
    "CheckNatCommand": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-Network-CheckCommand",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceNatCommand",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "ChoiceNatCommand": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.command_status",
          "StringEquals": "SUCCEEDED",
          "Next": "DeleteNovaVM"
        }
      ],
      "Default": "WaitNatCommand"
    },
    "DeleteNovaVM": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteNova",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "FinalizeNetworkRelease",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "FinalizeNetworkRelease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-Network-Release",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "TimeoutError",
            "TransactionCanceledException",
            "ConditionalCheckFailedException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "DeleteSecurityGroup",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "DeleteSecurityGroup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteSecurityGroup",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "DeleteVolume",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "DeleteVolume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteVolume",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "VolumeDeletionStatus",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "VolumeDeletionStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.volume_cleanup.status",
          "StringEquals": "DELETED",
          "Next": "SyncDynamoDB"
        }
      ],
      "Default": "WaitVolumeDeletion"
    },
    "WaitVolumeDeletion": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "DeleteVolume"
    },
    "SyncDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-SyncDynamoDB",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "TerminationSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "TerminationSuccess": {
      "Type": "Succeed"
    },
    "TerminationFailed": {
      "Type": "Fail",
      "Error": "TerminationError"
    },
    "LegacyDeleteSecurityGroup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteSecurityGroup",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "LegacyDeleteNova",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "LegacyDeleteNova": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteNova",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "LegacyDeleteVolume",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "LegacyDeleteVolume": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-DeleteVolume",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "LegacyVolumeDeletionStatus",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    },
    "LegacyVolumeDeletionStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.volume_cleanup.status",
          "StringEquals": "DELETED",
          "Next": "LegacyReleaseEIP"
        }
      ],
      "Default": "WaitLegacyVolumeDeletion"
    },
    "WaitLegacyVolumeDeletion": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "LegacyDeleteVolume"
    },
    "LegacyReleaseEIP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-TerminateInstance-ReleaseEIP",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "SyncDynamoDB",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "TerminationFailed"
        }
      ]
    }
  }
}
