{
  "RoleName": "DB-AccessRole",
  "PolicyName": "XRegion-SnapshotManagementPolicy",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "ec2:CreateSnapshot",
          "ec2:CopySnapshot",
          "ec2:DeleteSnapshot",
          "ec2:DescribeSnapshots",
          "ec2:CreateTags"
        ],
        "Resource": "*"
      }
    ]
  }
}
