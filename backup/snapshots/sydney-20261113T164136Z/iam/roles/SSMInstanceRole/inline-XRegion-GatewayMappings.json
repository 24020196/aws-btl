{
  "RoleName": "SSMInstanceRole",
  "PolicyName": "XRegion-GatewayMappings",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Resource": [
          "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkMappings",
          "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkMappings/index/gateway_host_id-index",
