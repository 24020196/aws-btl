          "arn:aws:states:us-east-1:291634989063:stateMachine:TerminateInstance",
          "arn:aws:states:us-east-1:291634989063:stateMachine:MigrateInstance",
          "arn:aws:states:us-east-1:291634989063:stateMachine:MigrateTargetBoot",
          "arn:aws:states:ap-southeast-2:291634989063:stateMachine:MigrateSourceCleanup",
