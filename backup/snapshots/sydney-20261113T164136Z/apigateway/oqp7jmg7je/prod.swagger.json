      "post" : {
        "summary" : "Tiep nhan va day su kien nghiep vu vao Amazon EventBridge",
        "description" : "Tiep nhan payload su kien chuan JSON Envelope (VM Lifecycle, SSH Key, Migration), xac thuc API Token doc lap qua Lambda Authorizer va day truc tiep vao EventBridge default bus.",
        "consumes" : [ "application/json" ],
        "responses" : {
          "200" : {
            "description" : "Tiep nhan su kien thanh cong vao Amazon EventBridge bus 'default' voi FailedEntryCount: 0."
