{
  "Comment": "xregion linux-nat-v1 contract 1",
  "StartAt": "SetModeLoad",
  "TimeoutSeconds": 300,
  "States": {
    "SetModeLoad": {
      "Type": "Pass",
      "Result": "LOAD",
      "ResultPath": "$.mode",
      "Next": "LoadInstance"
    },
    "LoadInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-InstanceLifecycle",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceLoaded",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "LifecycleFailed"
        }
      ]
    },
    "ChoiceLoaded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "ALREADY_HANDLED",
          "Next": "AlreadyHandled"
        },
        {
          "Variable": "$.status",
          "StringEquals": "REJECTED",
          "Next": "LifecycleRejected"
        },
        {
          "Variable": "$.status",
          "StringEquals": "FAILED",
          "Next": "LifecycleFailed"
        },
        {
          "Variable": "$.already_at_target",
          "BooleanEquals": true,
          "Next": "SetModeSync"
        }
      ],
      "Default": "SetModeDispatch"
    },
    "SetModeDispatch": {
      "Type": "Pass",
      "Result": "DISPATCH",
      "ResultPath": "$.mode",
      "Next": "DispatchAction"
    },
    "DispatchAction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-InstanceLifecycle",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceDispatched",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "LifecycleFailed"
        }
      ]
    },
    "ChoiceDispatched": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "REJECTED",
          "Next": "LifecycleRejected"
        }
      ],
      "Default": "WaitStatus"
    },
    "WaitStatus": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "SetModeStatus"
    },
    "SetModeStatus": {
      "Type": "Pass",
      "Result": "STATUS",
      "ResultPath": "$.mode",
      "Next": "CheckStatus"
    },
    "CheckStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-InstanceLifecycle",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceStatus",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "LifecycleFailed"
        }
      ]
    },
    "ChoiceStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "STOP"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "SHUTOFF"
            }
          ],
          "Next": "SetModeSync"
        },
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "STOP"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "STOPPED"
            }
          ],
          "Next": "SetModeSync"
        },
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "START"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "ACTIVE"
            }
          ],
          "Next": "SetModeSync"
        },
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "REBOOT"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "ACTIVE"
            },
            {
              "Variable": "$.saw_transition",
              "BooleanEquals": true
            },
            {
              "Variable": "$.task_state",
              "IsNull": true
            }
          ],
          "Next": "SetModeSync"
        },
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "START"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "SHELVED"
            }
          ],
          "Next": "LifecycleRejected"
        },
        {
          "And": [
            {
              "Variable": "$.action",
              "StringEquals": "START"
            },
            {
              "Variable": "$.observed_status",
              "StringEquals": "SHELVED_OFFLOADED"
            }
          ],
          "Next": "LifecycleRejected"
        },
        {
          "Variable": "$.status",
          "StringEquals": "REJECTED",
          "Next": "LifecycleRejected"
        },
        {
          "Variable": "$.observed_status",
          "StringEquals": "ERROR",
          "Next": "LifecycleFailed"
        }
      ],
      "Default": "WaitStatus"
    },
    "SetModeSync": {
      "Type": "Pass",
      "Result": "SYNC",
      "ResultPath": "$.mode",
      "Next": "SyncDynamoDB"
    },
    "SyncDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-InstanceLifecycle",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "LifecycleSucceeded",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "LifecycleFailed"
        }
      ]
    },
    "LifecycleSucceeded": {
      "Type": "Succeed"
    },
    "AlreadyHandled": {
      "Type": "Succeed"
    },
    "LifecycleRejected": {
      "Type": "Fail",
      "Error": "LifecycleRejected",
      "Cause": "Yêu cầu vòng đời vi phạm SPEC-01/SPEC-SF-06"
    },
    "LifecycleFailed": {
      "Type": "Fail",
      "Error": "LifecycleError",
      "Cause": "Không quan sát được trạng thái Nova mong đợi"
    }
  }
}
