{
  "Comment": "SPEC-SF-08 v1.2.0 MigrateInstance (us-east-1)",
  "StartAt": "CleanPendingSnapshots",
  "TimeoutSeconds": 900,
  "States": {
    "CleanPendingSnapshots": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-CleanSnapshots",
        "Payload": {
          "request.$": "$",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "StopSourceInstance",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "StopSourceInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-StopSource",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "StartSourceSnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "StartSourceSnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-CreateAndCopy",
        "Payload": {
          "action": "start_source_snapshot",
          "instance_id.$": "$.instance_id",
          "source_volume_id.$": "$.source_volume_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "migration_id.$": "$.migration_id",
          "source_nova_id.$": "$.source_nova_id",
          "nova_id.$": "$.nova_id",
          "execution_arn.$": "$.execution_arn"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitSourceSnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "WaitSourceSnapshot": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "CheckSourceSnapshot"
    },
    "CheckSourceSnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-CreateAndCopy",
        "Payload": {
          "action": "check_source_snapshot",
          "instance_id.$": "$.instance_id",
          "source_volume_id.$": "$.source_volume_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "migration_id.$": "$.migration_id",
          "source_nova_id.$": "$.source_nova_id",
          "nova_id.$": "$.nova_id",
          "source_snapshot_id.$": "$.source_snapshot_id",
          "execution_arn.$": "$.execution_arn"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceSourceSnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "ChoiceSourceSnapshot": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.source_snapshot_status",
          "StringEquals": "completed",
          "Next": "StartCopySnapshot"
        }
      ],
      "Default": "WaitSourceSnapshot"
    },
    "StartCopySnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-CreateAndCopy",
        "Payload": {
          "action": "start_copy_snapshot",
          "instance_id.$": "$.instance_id",
          "source_volume_id.$": "$.source_volume_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "migration_id.$": "$.migration_id",
          "source_nova_id.$": "$.source_nova_id",
          "nova_id.$": "$.nova_id",
          "source_snapshot_id.$": "$.source_snapshot_id",
          "execution_arn.$": "$.execution_arn"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitCopySnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "WaitCopySnapshot": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "CheckCopySnapshot"
    },
    "CheckCopySnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-CreateAndCopy",
        "Payload": {
          "action": "check_copy_snapshot",
          "instance_id.$": "$.instance_id",
          "source_volume_id.$": "$.source_volume_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "migration_id.$": "$.migration_id",
          "source_nova_id.$": "$.source_nova_id",
          "nova_id.$": "$.nova_id",
          "source_snapshot_id.$": "$.source_snapshot_id",
          "dest_snapshot_id.$": "$.dest_snapshot_id",
          "execution_arn.$": "$.execution_arn"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "ChoiceCopySnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "ChoiceCopySnapshot": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.dest_snapshot_status",
          "StringEquals": "completed",
          "Next": "TriggerTargetLaunch"
        }
      ],
      "Default": "WaitCopySnapshot"
    },
    "TriggerTargetLaunch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-TriggerTargetLaunch",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "MigrationSourceSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationFailure"
        }
      ]
    },
    "MigrationSourceSuccess": {
      "Type": "Succeed"
    },
    "MarkMigrationFailure": {
      "Type": "Pass",
      "Next": "RollbackDeleteDestSnapshot"
    },
    "RollbackDeleteDestSnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-Rollback",
        "Payload": {
          "action": "delete_dest_snapshot",
          "instance_id.$": "$.instance_id",
          "migration_id.$": "$.migration_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "source_nova_id.$": "$.source_nova_id",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "RollbackDeleteSourceSnapshot",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rb_err",
          "Next": "RollbackDeleteSourceSnapshot"
        }
      ]
    },
    "RollbackDeleteSourceSnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-Rollback",
        "Payload": {
          "action": "delete_source_snapshot",
          "instance_id.$": "$.instance_id",
          "migration_id.$": "$.migration_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "source_nova_id.$": "$.source_nova_id",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "RollbackStartSourceVM",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rb_err",
          "Next": "RollbackStartSourceVM"
        }
      ]
    },
    "RollbackStartSourceVM": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-Rollback",
        "Payload": {
          "action": "start_source_vm",
          "instance_id.$": "$.instance_id",
          "migration_id.$": "$.migration_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "source_nova_id.$": "$.source_nova_id",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "RecordMigrationRollbackResult",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rb_err",
          "Next": "RecordMigrationRollbackResult"
        }
      ]
    },
    "RecordMigrationRollbackResult": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-Migrate-Rollback",
        "Payload": {
          "action": "record_rollback_result",
          "instance_id.$": "$.instance_id",
          "migration_id.$": "$.migration_id",
          "source_region.$": "$.source_region",
          "dest_region.$": "$.dest_region",
          "source_nova_id.$": "$.source_nova_id",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "MigrationFailed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "MigrationFailed"
        }
      ]
    },
    "MigrationFailed": {
      "Type": "Fail",
      "Error": "MigrationError"
    }
  }
}
