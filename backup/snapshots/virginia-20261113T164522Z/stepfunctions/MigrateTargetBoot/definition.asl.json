          "ResultPath": "$.rollback_error",
          "Next": "RollbackDeleteNova_SetAction"
        }
      ],
      "Next": "RollbackWaitNatCommand"
    },
    "RollbackSecurityGroup_SetAction": {
      "Type": "Pass",
      "Result": "delete_sg",
      "ResultPath": "$.action",
      "Next": "RollbackSecurityGroup"
    },
    "RollbackSecurityGroup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-MigrateTarget-AssignSecurityGroup",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "RollbackReleaseEIP_SetAction"
        }
      ],
      "Next": "RollbackReleaseEIP_SetAction"
    },
    "RollbackDeleteNova_SetAction": {
      "Type": "Pass",
      "Result": "delete_nova",
      "ResultPath": "$.action",
      "Next": "RollbackDeleteNova"
    },
    "RollbackDeleteNova": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
