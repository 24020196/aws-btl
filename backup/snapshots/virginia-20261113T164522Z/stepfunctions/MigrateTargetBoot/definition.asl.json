        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "RollbackSecurityGroup_SetAction"
        }
      ],
      "Next": "RollbackSecurityGroup_SetAction"
    },
    "RollbackReleaseEIP_SetAction": {
      "Type": "Pass",
      "Result": "release_eip",
      "ResultPath": "$.action",
      "Next": "RollbackReleaseEIP"
    },
    "RollbackReleaseEIP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-MigrateTarget-Network",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "RollbackDeleteVolume_SetAction"
        }
      ],
      "Next": "RollbackDeleteVolume_SetAction"
    },
    "RollbackDeleteNovaPreCommit_SetAction": {
