          "BackoffRate": 2.0
        }
      ],
      "Next": "MigrateBootSuccess"
    },
    "MigrateBootSuccess": {
      "Type": "Succeed"
    },
    "MarkMigrationTargetFailure": {
      "Type": "Pass",
      "Next": "RollbackCheckMapping_SetAction"
    },
    "RollbackCheckMapping_SetAction": {
      "Type": "Pass",
      "Result": "check_mapping_committed",
      "ResultPath": "$.action",
      "Next": "RollbackCheckMapping"
    },
    "RollbackCheckMapping": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-MigrateTarget-Network",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "RollbackDeleteNovaPreCommit_SetAction"
        }
      ],
      "Next": "ChoiceRollbackMapping"
    },
    "ChoiceRollbackMapping": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.network_committed",
          "BooleanEquals": true,
          "Next": "RollbackNat_SetAction"
        }
      ],
      "Default": "RollbackDeleteNovaPreCommit_SetAction"
    },
    "RollbackNat_SetAction": {
      "Type": "Pass",
