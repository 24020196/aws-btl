{
  "Comment": "SPEC-SF-09 v1.6.0: Target region boot from snapshot Cinder volume, VerifyNetwork, TriggerSourceCleanup & 2-layer Rollback",
  "StartAt": "CreateVolumeFromSnapshot_SetAction",
  "TimeoutSeconds": 600,
