    },
    "CreateVolumeFromSnapshot": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:291634989063:function:XRegion-MigrateTarget-Volume",
        "Payload": {
          "request.$": "$",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkMigrationTargetFailure"
        }
      ],
      "Next": "WaitTargetVolume"
    },
    "WaitTargetVolume": {
