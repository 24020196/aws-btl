{
  "type": "AWS::IAM::Role",
  "identifier": "DB-AccessRole",
  "properties": {
    "Path": "/",
    "ManagedPolicyArns": [
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
      "arn:aws:iam::aws:policy/AmazonDynamoDBFullAccess",
      "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
    ],
    "MaxSessionDuration": 3600,
    "RoleName": "DB-AccessRole",
    "Description": "Allows Lambda functions to call AWS services on your behalf.",
    "Policies": [
      {
        "PolicyName": "EC2EIPManagementPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "ec2:DescribeAddresses",
                "ec2:AllocateAddress",
                "ec2:ReleaseAddress",
                "ec2:AssociateAddress",
                "ec2:DisassociateAddress",
                "ec2:AssignPrivateIpAddresses",
                "ec2:UnassignPrivateIpAddresses",
                "ec2:DescribeNetworkInterfaces",
                "ec2:CreateTags"
              ],
              "Resource": "*",
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "LambdaEC2VolumeManagement",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "ec2:CreateVolume",
                "ec2:AttachVolume",
                "ec2:DetachVolume",
                "ec2:DeleteVolume",
                "ec2:DescribeVolumes",
                "ec2:DescribeVolumeStatus",
                "ec2:DescribeInstances",
                "ec2:CreateTags"
              ],
              "Resource": "*",
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "XRegion-ExtendOwnership",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "dynamodb:GetItem"
              ],
              "Resource": [
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-Instances",
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-Volumes",
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkReservations",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-Instances",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-Volumes",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-NetworkReservations"
              ],
              "Effect": "Allow"
            },
            {
              "Action": [
                "dynamodb:UpdateItem"
              ],
              "Resource": [
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-Volumes",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-Volumes"
              ],
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "XRegion-LaunchAdmission",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "ssm:GetParameter"
              ],
              "Resource": [
                "arn:aws:ssm:ap-southeast-2:291634989063:parameter/xregion/ap-southeast-2/launch/admission",
                "arn:aws:ssm:us-east-1:291634989063:parameter/xregion/us-east-1/launch/admission"
              ],
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "XRegion-NetworkV1",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:TransactWriteItems"
              ],
              "Resource": [
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkMappings",
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkReservations",
                "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-NetworkMappings/index/*",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-NetworkMappings",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-NetworkReservations",
                "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-NetworkMappings/index/*"
              ],
              "Effect": "Allow"
            },
            {
              "Action": [
                "ssm:SendCommand"
              ],
              "Resource": [
                "arn:aws:ssm:ap-southeast-2:291634989063:document/XRegion-NetworkGateway",
                "arn:aws:ec2:ap-southeast-2:291634989063:instance/i-056d7f3dd24156234",
                "arn:aws:ssm:us-east-1:291634989063:document/XRegion-NetworkGateway",
                "arn:aws:ec2:us-east-1:291634989063:instance/i-07738a186534cb5ba"
              ],
              "Effect": "Allow"
            },
            {
              "Action": [
                "ssm:GetCommandInvocation"
              ],
              "Resource": "*",
              "Effect": "Allow"
            },
            {
              "Action": [
                "ec2:DescribeAddresses",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeSubnets",
                "ec2:DescribeInstanceTypes",
                "ec2:DescribeInstances"
              ],
              "Resource": "*",
              "Effect": "Allow"
            },
            {
              "Action": [
                "ec2:AssignPrivateIpAddresses",
                "ec2:UnassignPrivateIpAddresses"
              ],
              "Resource": [
                "arn:aws:ec2:ap-southeast-2:291634989063:network-interface/eni-091eaee3e69e3f42d",
                "arn:aws:ec2:us-east-1:291634989063:network-interface/eni-0ed6a1623d49ebe3a"
              ],
              "Effect": "Allow"
            },
            {
              "Action": [
                "ec2:AssociateAddress",
                "ec2:DisassociateAddress",
                "ec2:CreateTags",
                "ec2:DeleteTags"
              ],
              "Resource": [
                "arn:aws:ec2:ap-southeast-2:291634989063:elastic-ip/*",
                "arn:aws:ec2:ap-southeast-2:291634989063:network-interface/eni-091eaee3e69e3f42d",
                "arn:aws:ec2:us-east-1:291634989063:elastic-ip/*",
                "arn:aws:ec2:us-east-1:291634989063:network-interface/eni-0ed6a1623d49ebe3a"
              ],
              "Effect": "Allow"
            },
            {
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                "arn:aws:logs:ap-southeast-2:291634989063:log-group:/aws/lambda/XRegion-Network-*:*",
                "arn:aws:logs:ap-southeast-2:291634989063:log-group:/xregion/network/ssm:*",
                "arn:aws:logs:us-east-1:291634989063:log-group:/aws/lambda/XRegion-Network-*:*",
                "arn:aws:logs:us-east-1:291634989063:log-group:/xregion/network/ssm:*"
              ],
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "XRegion-PoolReplenishment",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "lambda:InvokeFunction"
              ],
              "Resource": [
                "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-CinderPoolManager",
                "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-EIPPoolManager",
                "arn:aws:lambda:ap-southeast-2:291634989063:function:XRegion-SyncSecurityGroup",
                "arn:aws:lambda:us-east-1:291634989063:function:XRegion-CinderPoolManager",
                "arn:aws:lambda:us-east-1:291634989063:function:XRegion-EIPPoolManager",
                "arn:aws:lambda:us-east-1:291634989063:function:XRegion-SyncSecurityGroup"
              ],
              "Effect": "Allow"
            }
          ]
        }
      },
      {
        "PolicyName": "XRegion-SnapshotManagementPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "ec2:CreateSnapshot",
                "ec2:CopySnapshot",
                "ec2:DeleteSnapshot",
                "ec2:DescribeSnapshots",
                "ec2:CreateTags"
              ],
              "Resource": "*",
              "Effect": "Allow"
            }
          ]
        }
      }
    ],
    "AssumeRolePolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          }
        }
      ]
    },
    "Arn": "arn:aws:iam::291634989063:role/DB-AccessRole",
    "RoleId": "AROAUHZWMZAD54KIFXOUI"
  }
}
