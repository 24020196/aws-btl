{
  "RoleName": "XRegion-InstanceRecovery-ExecutionRole",
  "PolicyName": "InstanceRecovery",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ]
      },
      {
        "Effect": "Allow",
        "Resource": [
          "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-Instances",
          "arn:aws:dynamodb:ap-southeast-2:291634989063:table/XRegion-Nova",
          "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-Instances",
          "arn:aws:dynamodb:us-east-1:291634989063:table/XRegion-Nova"
        ],
        "Action": [
          "dynamodb:Scan",
          "dynamodb:GetItem",
          "dynamodb:UpdateItem"
        ]
      },
      {
        "Effect": "Allow",
        "Resource": [
          "arn:aws:states:ap-southeast-2:291634989063:execution:TerminateInstance:*",
          "arn:aws:states:us-east-1:291634989063:execution:TerminateInstance:*"
        ],
        "Action": [
          "states:DescribeExecution"
        ]
      },
      {
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "ec2:CreateNetworkInterface",
          "ec2:DescribeNetworkInterfaces",
          "ec2:DeleteNetworkInterface"
        ]
      }
    ]
  }
}
