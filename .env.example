# XRegion Environment Configuration File (.env.example) - Direct AWS Cloud Connection

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=cloud

# AWS Credentials
AWS_ACCOUNT_ID=348498387626
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Set this only when using temporary STS credentials.
AWS_SESSION_TOKEN=

# API Gateway EventBridge Endpoints
AWS_APIGATEWAY_EVENT_ENDPOINT=https://p8rwmv21ud.execute-api.ap-southeast-2.amazonaws.com/prod/events
AWS_APIGATEWAY_EVENT_ENDPOINT_AP_SOUTHEAST_2=https://p8rwmv21ud.execute-api.ap-southeast-2.amazonaws.com/prod/events
AWS_APIGATEWAY_EVENT_ENDPOINT_US_EAST_1=https://o495nrvj1d.execute-api.us-east-1.amazonaws.com/prod/events

# Real DynamoDB Table ARNs on AWS Cloud
DYNAMODB_INSTANCES_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Instances
DYNAMODB_MIGRATIONS_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Migrations
DYNAMODB_NOVA_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Nova
DYNAMODB_USERS_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Users
DYNAMODB_IMAGES_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Images
DYNAMODB_FLAVORS_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-Flavors
DYNAMODB_MIGRATION_SCENARIOS_TABLE_ARN=arn:aws:dynamodb:ap-southeast-2:348498387626:table/XRegion-MigrationScenarios

# DynamoDB Endpoint (Để trống để kết nối trực tiếp AWS Cloud qua HTTPS)
DYNAMODB_ENDPOINT=

# Security (JWT)
JWT_SECRET=XRegionEnterpriseSecretKeyWithAtLeast256BitsLengthForSecureHMACSHA256Tokens
JWT_EXPIRATION_HOURS=24
